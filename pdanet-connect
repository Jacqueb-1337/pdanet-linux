#!/bin/bash
# PdaNet+ Android USB connector for Linux.
# Uses the actual PdaNet desktop protocol over ADB and a TUN interface.

set -Eeuo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(dirname "$SCRIPT_PATH")"
HELPER="$PROJECT_DIR/src/pdanet_usb_tunnel.py"
PIDFILE="/run/pdanet-linux-usb.pid"
LOGFILE="/tmp/pdanet-linux-usb.log"
WATCHDOG="$PROJECT_DIR/scripts/pdanet-watchdog.sh"
WATCHDOG_PIDFILE="/run/pdanet-linux-watchdog.pid"
DNS_HELPER="$PROJECT_DIR/scripts/pdanet-dns.sh"
PACKAGEKIT_FIX="$PROJECT_DIR/scripts/pdanet-packagekit-route-mode.sh"

if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}Error: This command must run as root.${NC}"
    echo "Use: sudo pdanet-connect"
    exit 1
fi

# pkexec and sudo both change HOME. Recover the desktop user's home so adb
# can use the Android authorization key the user already approved.
REAL_UID="${PKEXEC_UID:-}"
if [[ -z "$REAL_UID" && -n "${SUDO_USER:-}" ]]; then
    REAL_UID="$(id -u "$SUDO_USER" 2>/dev/null || true)"
fi
if [[ -z "$REAL_UID" || "$REAL_UID" == "0" ]]; then
    REAL_UID="$(stat -c '%u' "$PROJECT_DIR" 2>/dev/null || echo 0)"
fi
USER_HOME="$(getent passwd "$REAL_UID" 2>/dev/null | cut -d: -f6 || true)"
if [[ -n "$USER_HOME" ]]; then
    export HOME="$USER_HOME"
    export ADB_VENDOR_KEYS="$USER_HOME/.android"
fi

echo -e "${GREEN}PdaNet Linux USB Connector${NC}"
echo "======================================"

if [[ ! -x "$HELPER" ]]; then
    echo -e "${RED}Error: USB tunnel helper is missing: $HELPER${NC}"
    exit 1
fi
if ! command -v adb >/dev/null 2>&1; then
    echo -e "${RED}Error: adb is not installed.${NC}"
    echo "Install it with: sudo apt install adb"
    exit 1
fi
if [[ ! -c /dev/net/tun ]]; then
    echo -e "${RED}Error: /dev/net/tun is unavailable.${NC}"
    exit 1
fi

echo -e "${YELLOW}[1/4]${NC} Checking Android USB connection..."
ADB_DEVICES="$(adb devices 2>/dev/null || true)"
if ! grep -q $'\tdevice$' <<<"$ADB_DEVICES"; then
    echo -e "${RED}Error: No authorized Android device is available through adb.${NC}"
    echo "Connect the phone, enable USB debugging, then approve the computer on the phone."
    exit 1
fi
echo -e "${GREEN}✓${NC} Android device authorized"

echo -e "${YELLOW}[2/4]${NC} Checking PdaNet+ USB service..."
# USB mode exposes PdaNet's desktop server on TCP 8739 (0x2223) on the phone.
if ! adb shell 'cat /proc/net/tcp /proc/net/tcp6 2>/dev/null' | grep -qi ':2223 .* 0A '; then
    echo -e "${RED}Error: PdaNet+ USB mode is not listening on the phone.${NC}"
    echo "Open PdaNet+ and turn on 'Activate USB Mode'."
    exit 1
fi
echo -e "${GREEN}✓${NC} PdaNet+ USB service detected"

# If a tunnel already exists, only reuse it if it is actually carrying traffic
# and DNS is working. Otherwise clean it up and rebuild it automatically.
if [[ -f "$PIDFILE" ]]; then
    OLD_PID="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null && ip link show pdanet0 >/dev/null 2>&1; then
        if ip route get 1.1.1.1 2>/dev/null | grep -q 'dev pdanet0' \
            && curl -k -sS --interface pdanet0 --connect-timeout 3 --max-time 6 https://1.1.1.1/cdn-cgi/trace >/dev/null 2>&1 \
            && getent ahostsv4 example.com >/dev/null 2>&1; then
            echo -e "${GREEN}✓${NC} PdaNet USB tunnel is already connected and healthy"
            if [[ "${PDANET_SKIP_WATCHDOG:-0}" != "1" ]] && [[ -x "$WATCHDOG" ]]; then
                WATCHDOG_RUNNING=false
                if [[ -f "$WATCHDOG_PIDFILE" ]]; then
                    WATCHDOG_PID="$(cat "$WATCHDOG_PIDFILE" 2>/dev/null || true)"
                    if [[ -n "$WATCHDOG_PID" ]] && kill -0 "$WATCHDOG_PID" 2>/dev/null; then
                        WATCHDOG_RUNNING=true
                    else
                        rm -f "$WATCHDOG_PIDFILE"
                    fi
                fi
                if [[ "$WATCHDOG_RUNNING" != true ]]; then
                    nohup "$WATCHDOG" >/dev/null 2>&1 &
                    echo -e "${GREEN}✓${NC} Self-healing connection watchdog started"
                fi
            fi
            exit 0
        fi
        echo -e "${YELLOW}Existing PdaNet tunnel is stale; rebuilding it automatically...${NC}"
        kill "$OLD_PID" 2>/dev/null || true
        sleep 0.5
        kill -9 "$OLD_PID" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
fi

# Remove leftovers from an interrupted run.
ip link del pdanet0 >/dev/null 2>&1 || true
adb forward --remove tcp:18739 >/dev/null 2>&1 || true

echo -e "${YELLOW}[3/4]${NC} Starting native PdaNet USB tunnel..."
: > "$LOGFILE"
nohup python3 "$HELPER" --default-route >>"$LOGFILE" 2>&1 &
TUN_PID=$!
echo "$TUN_PID" > "$PIDFILE"

# Wait for the helper to create the interface and finish the PdaNet handshake.
for _ in $(seq 1 40); do
    if ! kill -0 "$TUN_PID" 2>/dev/null; then
        echo -e "${RED}Error: PdaNet tunnel exited during startup.${NC}"
        cat "$LOGFILE"
        rm -f "$PIDFILE"
        exit 1
    fi
    if ip link show pdanet0 >/dev/null 2>&1 && grep -q 'Phone ready' "$LOGFILE" 2>/dev/null; then
        break
    fi
    sleep 0.1
done

if ! ip link show pdanet0 >/dev/null 2>&1; then
    echo -e "${RED}Error: pdanet0 was not created.${NC}"
    cat "$LOGFILE"
    kill "$TUN_PID" 2>/dev/null || true
    rm -f "$PIDFILE"
    exit 1
fi

echo -e "${GREEN}✓${NC} PdaNet protocol connected, interface pdanet0 is active"

# Put the system resolver on the same path as pdanet0. Browsers can appear to
# work through DoH while apt/PackageKit still fail if the OS resolver points at
# a stale WiFi DNS server, so use the dedicated resolver helper here.
if [[ -x "$DNS_HELPER" ]]; then
    "$DNS_HELPER" apply || true
fi

echo -e "${YELLOW}[4/4]${NC} Verifying traffic through the phone..."
if ! ip route get 1.1.1.1 2>/dev/null | grep -q 'dev pdanet0'; then
    echo -e "${RED}Error: PdaNet default route was not installed.${NC}"
    [[ -x "$DNS_HELPER" ]] && "$DNS_HELPER" restore || true
    kill "$TUN_PID" 2>/dev/null || true
    rm -f "$PIDFILE"
    exit 1
fi

TRANSPORT_OK=false
for _ in 1 2 3; do
    if curl -k -sS --interface pdanet0 --connect-timeout 4 --max-time 8 https://1.1.1.1/cdn-cgi/trace >/dev/null 2>&1; then
        TRANSPORT_OK=true
        break
    fi
    sleep 1
done
if [[ "$TRANSPORT_OK" != true ]]; then
    echo -e "${RED}Error: PdaNet connected to the phone, but the phone is not passing Internet traffic.${NC}"
    echo "Open PdaNet+ on the phone, toggle USB Tether off and back on, then retry."
    cat "$LOGFILE"
    [[ -x "$DNS_HELPER" ]] && "$DNS_HELPER" restore || true
    kill "$TUN_PID" 2>/dev/null || true
    rm -f "$PIDFILE"
    ip link del pdanet0 >/dev/null 2>&1 || true
    exit 1
fi

echo -e "${GREEN}✓${NC} Raw Internet traffic verified through PdaNet+"

# Verify the same system resolver used by apt and PackageKit, not just browser
# traffic. If it is still broken, force the resolver helper to apply its static
# fallback before giving up.
DNS_OK=false
for _ in 1 2 3; do
    if [[ -x "$DNS_HELPER" ]] && "$DNS_HELPER" check; then
        DNS_OK=true
        break
    fi
    [[ -x "$DNS_HELPER" ]] && "$DNS_HELPER" apply || true
    sleep 1
done
if [[ "$DNS_OK" == true ]]; then
    echo -e "${GREEN}✓${NC} System DNS verified for apt and PackageKit"
    if [[ -x "$PACKAGEKIT_FIX" ]]; then
        "$PACKAGEKIT_FIX" || true
    fi
    command -v systemctl >/dev/null 2>&1 && systemctl restart packagekit.service >/dev/null 2>&1 || true
    command -v nmcli >/dev/null 2>&1 && nmcli networking connectivity check >/dev/null 2>&1 || true
else
    echo -e "${RED}Error: PdaNet traffic works, but system DNS could not be configured.${NC}"
    echo "The connection was not marked successful because apt and Software Manager would not work reliably."
    [[ -x "$DNS_HELPER" ]] && "$DNS_HELPER" restore || true
    kill "$TUN_PID" 2>/dev/null || true
    rm -f "$PIDFILE"
    ip link del pdanet0 >/dev/null 2>&1 || true
    exit 1
fi

# Keep route and DNS healthy after NetworkManager, hotel WiFi, resume, or a
# transient phone-side stall changes networking underneath the tunnel.
if [[ "${PDANET_SKIP_WATCHDOG:-0}" != "1" ]] && [[ -x "$WATCHDOG" ]]; then
    WATCHDOG_RUNNING=false
    if [[ -f "$WATCHDOG_PIDFILE" ]]; then
        WATCHDOG_PID="$(cat "$WATCHDOG_PIDFILE" 2>/dev/null || true)"
        if [[ -n "$WATCHDOG_PID" ]] && kill -0 "$WATCHDOG_PID" 2>/dev/null; then
            WATCHDOG_RUNNING=true
        else
            rm -f "$WATCHDOG_PIDFILE"
        fi
    fi
    if [[ "$WATCHDOG_RUNNING" != true ]]; then
        nohup "$WATCHDOG" >/dev/null 2>&1 &
        echo -e "${GREEN}✓${NC} Self-healing connection watchdog started"
    fi
fi

echo
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}PdaNet USB connection established!${NC}"
echo -e "${GREEN}========================================${NC}"
echo "Interface: pdanet0"
echo "Tunnel IP: 10.1.19.2"
echo "To disconnect: sudo pdanet-disconnect"
