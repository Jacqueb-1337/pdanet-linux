#!/bin/bash
# Stop the native PdaNet+ USB-over-ADB tunnel and restore the previous route.

set -Eeuo pipefail
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
PIDFILE="/run/pdanet-linux-usb.pid"
WATCHDOG_PIDFILE="/run/pdanet-linux-watchdog.pid"

if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}Error: This command must run as root.${NC}"
    exit 1
fi

REAL_UID="${PKEXEC_UID:-}"
if [[ -z "$REAL_UID" && -n "${SUDO_USER:-}" ]]; then REAL_UID="$(id -u "$SUDO_USER" 2>/dev/null || true)"; fi
if [[ -n "$REAL_UID" && "$REAL_UID" != "0" ]]; then
    USER_HOME="$(getent passwd "$REAL_UID" 2>/dev/null | cut -d: -f6 || true)"
    if [[ -n "$USER_HOME" ]]; then export HOME="$USER_HOME"; export ADB_VENDOR_KEYS="$USER_HOME/.android"; fi
fi

echo -e "${GREEN}PdaNet Linux USB Disconnector${NC}"
echo "======================================"

if [[ -f "$WATCHDOG_PIDFILE" ]]; then
    WATCHDOG_PID="$(cat "$WATCHDOG_PIDFILE" 2>/dev/null || true)"
    if [[ -n "$WATCHDOG_PID" ]] && kill -0 "$WATCHDOG_PID" 2>/dev/null; then
        kill "$WATCHDOG_PID" 2>/dev/null || true
    fi
    rm -f "$WATCHDOG_PIDFILE"
fi

echo -e "${YELLOW}[1/3]${NC} Stopping USB tunnel..."
if [[ -f "$PIDFILE" ]]; then
    PID="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        for _ in $(seq 1 30); do
            kill -0 "$PID" 2>/dev/null || break
            sleep 0.1
        done
        kill -9 "$PID" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
fi
# Clean stale helpers from pre-PID-file development runs.
pkill -f '[p]danet_usb_tunnel.py' 2>/dev/null || true
ip link del pdanet0 >/dev/null 2>&1 || true
echo -e "${GREEN}✓${NC} Tunnel stopped"

echo -e "${YELLOW}[2/3]${NC} Removing ADB forwarding..."
if command -v adb >/dev/null 2>&1; then adb forward --remove tcp:18739 >/dev/null 2>&1 || true; fi
echo -e "${GREEN}✓${NC} ADB forwarding removed"

echo -e "${YELLOW}[3/3]${NC} Restoring normal routing..."
if command -v resolvectl >/dev/null 2>&1; then
    resolvectl revert pdanet0 >/dev/null 2>&1 || true
    resolvectl flush-caches >/dev/null 2>&1 || true
fi
if ip route show default | grep -q 'dev pdanet0'; then
    ip route del default dev pdanet0 >/dev/null 2>&1 || true
fi
if ip route show default | grep -qv 'dev pdanet0'; then
    echo -e "${GREEN}✓${NC} Previous network route is active"
else
    echo -e "${YELLOW}Warning: No fallback default route is currently available.${NC}"
fi

echo
echo -e "${GREEN}PdaNet USB disconnected successfully.${NC}"
